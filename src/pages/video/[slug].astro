---
// One template for every project video. It is a page only while developing (npm run dev, then
// /video/<slug>) and while `npm run videos` records it into public/videos/<slug>.mp4.
// The published site ships the recorded files, never this page.
import '../../styles/global.css';
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import profile from '../../data/profile.json';
import projects from '../../data/projects.json';
import { resolveAssetImage } from '../../utils/images';
import { videos, sceneTiming, faultTraces, STAGE } from '../../utils/videos';

export function getStaticPaths() {
  const enabled = import.meta.env.DEV || process.env.RENDER_VIDEOS === '1';
  if (!enabled) return [];
  return Object.keys(videos).map((slug) => ({ params: { slug } }));
}

const slug = String(Astro.params.slug);
const spec = videos[slug];
const project = projects.featured.find((p) => p.video === slug);
if (!spec || !project) throw new Error(`No featured project uses the video "${slug}"`);

const { scenes, total } = sceneTiming();
const timing = (id: keyof typeof scenes) => `--at: ${scenes[id].at}s; --dur: ${scenes[id].seconds}s`;
const sceneIds = Object.keys(scenes) as (keyof typeof scenes)[];

const cover = await resolveAssetImage(project.image);
const media = spec.poc.media;
const mediaImage = media.type === 'image' ? await resolveAssetImage(media.image) : null;
const clipPoster = media.type === 'clip' ? await resolveAssetImage(media.poster) : null;

const CHART = { width: 470, height: 88 };
const signals =
  media.type === 'signals'
    ? media.items.map((item) => ({ ...item, ...faultTraces(item.fault, CHART.width, CHART.height) }))
    : [];

// Task schedule: one row per task, one mark each time it runs inside the window.
const SWEEP = { start: 1.3, seconds: 4.2 };
const schedule =
  media.type === 'schedule'
    ? media.rows.map((row) => ({
        ...row,
        runs: Array.from({ length: Math.floor(media.window / row.every) }, (_, i) => ((i + 1) * row.every) / media.window),
      }))
    : [];

// The cover keeps its own proportions when the project asks for it (a small picture is not blown up).
const coverHeight = project.fit === 'natural' && cover ? `height: ${Math.round((500 * cover.height) / cover.width)}px; ` : '';

// Squares in the feature-map scene grow with the map they stand for.
const side = (cells: number) => Math.round(16 + cells * 1.15);

// A project without a repository closes on the GitHub profile.
const profileUrl = profile.socials.find((social) => social.icon === 'github')?.url ?? '';
const repo = (project.link || profileUrl).replace(/^https?:\/\//, '');
const barWidth = (value: number) => `${Math.max(2, Math.min(100, (value / spec.results.max) * 100)).toFixed(1)}%`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{project.title} | video</title>
  </head>
  <body>
    <div
      class="stage"
      data-total={total}
      style={`width: ${STAGE.width}px; height: ${STAGE.height}px`}
    >
      <div class="grid-bg"></div>

      <header class="top">
        <p class="brand">
          <svg class="mark" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M3 9V3h6M15 3h6v6M21 15v6h-6M9 21H3v-6" stroke="currentColor" stroke-width="2.2"></path>
            <rect x="9.5" y="9.5" width="5" height="5" fill="currentColor"></rect>
          </svg>
          {profile.name}
        </p>
        <p class="meta">
          {project.kind}
          {project.year && <span>{project.year}</span>}
        </p>
      </header>

      <!-- 1. Title -->
      <section class="scene scene--title" style={timing('title')}>
        <div class="title-block">
          <div class="corners lock" style="--d: 0.25s"><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>
          <p class="label in" style="--d: 0.3s">Project walkthrough</p>
          <h1 class="in" style="--d: 0.5s">{project.title}</h1>
        </div>
        <ul class="chips in" style="--d: 1.1s">
          {project.tech.map((t) => <li>{t}</li>)}
        </ul>
      </section>

      <!-- 2. Problem -->
      <section class="scene scene--split" style={timing('problem')}>
        <div class="col">
          <p class="label in" style="--d: 0.2s">The problem</p>
          <h2 class="statement in" style="--d: 0.45s">{spec.problem.statement}</h2>
          <p class="detail in" style="--d: 1.8s">{spec.problem.detail}</p>
        </div>
        <figure class={`frame zoom in ${project.fit === 'contain' ? 'frame--paper' : ''}`} style={`${coverHeight}--d: 0.7s`}>
          {cover && <Image src={cover} alt={project.imageAlt} width={Math.min(cover.width, 1100)} loading="eager" />}
          <div class="corners"><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>
        </figure>
      </section>

      <!-- 3. Approach -->
      <section class="scene" style={timing('approach')}>
        <p class="label in" style="--d: 0.2s">Approach</p>
        <h2 class="heading in" style="--d: 0.45s">{spec.approach.heading}</h2>
        <ol class="pipe">
          {
            spec.approach.nodes.map((node, i) => (
              <>
                {i > 0 && (
                  <li class="link" aria-hidden="true">
                    <svg width="56" height="24" viewBox="0 0 56 24" fill="none">
                      <path class="draw" style={`--d: ${(0.7 + i * 1.5).toFixed(2)}s`} d="M2 12H48" pathLength="1" />
                      <path class="pop" style={`--d: ${(1.2 + i * 1.5).toFixed(2)}s`} d="M41 5l9 7-9 7" />
                    </svg>
                  </li>
                )}
                <li class={`node in ${node.key ? 'node--key' : ''}`} style={`--d: ${(1.2 + i * 1.5).toFixed(2)}s`}>
                  <h3>{node.title}</h3>
                  <p>{node.text}</p>
                </li>
              </>
            ))
          }
        </ol>
      </section>

      <!-- 4. Proof of concept -->
      <section class="scene" style={timing('poc')}>
        <p class="label in" style="--d: 0.2s">Proof of concept</p>
        <h2 class="heading in" style="--d: 0.45s">{spec.poc.heading}</h2>
        <div class="poc">
          {
            media.type === 'image' && (
              <figure class={`frame zoom in ${media.fit === 'contain' ? 'frame--whole' : ''}`} style="--d: 0.8s">
                {mediaImage && <Image src={mediaImage} alt={media.alt} width={Math.min(mediaImage.width, 1100)} loading="eager" />}
                <div class="corners"><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>
              </figure>
            )
          }
          {
            media.type === 'clip' && (
              <figure class="frame in" style="--d: 0.8s">
                <video
                  src={`/video/clip/${media.clip}`}
                  poster={clipPoster?.src}
                  aria-label={media.alt}
                  data-at={scenes.poc.at + 0.8}
                  muted
                  playsinline
                  preload="auto"
                />
                <div class="corners"><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>
              </figure>
            )
          }
          {
            media.type === 'signals' && (
              <div class="signals in" style="--d: 0.8s">
                {signals.map((signal, i) => (
                  <div class="signal">
                    <p>{signal.label}</p>
                    <svg width={CHART.width} height={CHART.height} viewBox={`0 0 ${CHART.width} ${CHART.height}`} fill="none">
                      <line class="fault-at pop" style={`--d: ${(1.9 + i * 1.5).toFixed(2)}s`} x1={signal.faultX} x2={signal.faultX} y1="4" y2={CHART.height - 4} />
                      <path class="truth draw" style={`--d: ${(1.1 + i * 1.5).toFixed(2)}s; --len: 1.9s`} d={signal.truth} pathLength="1" />
                      <path class="reading draw" style={`--d: ${(1.9 + i * 1.5).toFixed(2)}s; --len: 1.1s`} d={signal.reading} pathLength="1" />
                    </svg>
                  </div>
                ))}
                <ul class="legend">
                  <li><i class="swatch swatch--truth"></i>{media.legend[0]}</li>
                  <li><i class="swatch swatch--reading"></i>{media.legend[1]}</li>
                  <li><i class="swatch swatch--at"></i>Fault starts</li>
                </ul>
              </div>
            )
          }
          {
            media.type === 'schedule' && (
              <div class="schedule in" style="--d: 0.8s">
                <div class="lanes">
                  {schedule.map((row) => (
                    <div class="lane">
                      <p>
                        {row.label}
                        <span>
                          {row.every} {media.unit}
                        </span>
                      </p>
                      <div class="runs">
                        {row.runs.map((at) => (
                          <i class="pop" style={`left: ${(at * 100).toFixed(2)}%; --d: ${(SWEEP.start + at * SWEEP.seconds).toFixed(2)}s`} />
                        ))}
                      </div>
                    </div>
                  ))}
                  <div class="sweep-track">
                    <i class="sweep" style={`--d: ${SWEEP.start}s; --len: ${SWEEP.seconds}s`} />
                  </div>
                </div>
                <p class="scale-line">
                  <span>0</span>
                  <span>
                    {media.window / 2} {media.unit}
                  </span>
                  <span>
                    {media.window} {media.unit}
                  </span>
                </p>
              </div>
            )
          }
          {
            media.type === 'scales' && (
              <div class="scales in" style="--d: 0.8s">
                {media.items.map((row, i) => (
                  <div class="scale">
                    <div class="map">
                      <i class="sq" style={`--side: ${side(row.a)}px`}></i>
                      <span>{row.from}</span>
                    </div>
                    <div class="via">
                      <svg width="110" height="24" viewBox="0 0 110 24" fill="none">
                        <path class="draw" style={`--d: ${(1.3 + i * 1.5).toFixed(2)}s`} d="M2 12H102" pathLength="1" />
                        <path class="pop" style={`--d: ${(1.8 + i * 1.5).toFixed(2)}s`} d="M95 5l9 7-9 7" />
                      </svg>
                      <span class="pop" style={`--d: ${(1.4 + i * 1.5).toFixed(2)}s`}>{media.via}</span>
                    </div>
                    <div class="map map--to pop" style={`--d: ${(1.8 + i * 1.5).toFixed(2)}s`}>
                      <i class="sq sq--to" style={`--side: ${side(row.b)}px`}></i>
                      <span>{row.to}</span>
                    </div>
                  </div>
                ))}
              </div>
            )
          }

          <dl class="facts">
            {
              spec.poc.facts.map((fact, i) => (
                <div class="in" style={`--d: ${(1.6 + i * 1.7).toFixed(2)}s`}>
                  <dt>{fact.value}</dt>
                  <dd>{fact.text}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- 5. Results -->
      <section class="scene" style={timing('results')}>
        <p class="label in" style="--d: 0.2s">Results</p>
        <h2 class="heading in" style="--d: 0.45s">{spec.results.heading}</h2>
        <div class="results">
          <ul class="bars">
            {
              spec.results.bars.map((bar, i) => (
                <li class="in" style={`--d: ${(1 + i * 0.5).toFixed(2)}s`}>
                  <span class="bar-label">{bar.label}</span>
                  <span class="track">
                    <i class="grow" style={`width: ${barWidth(bar.value)}; --d: ${(1.2 + i * 0.5).toFixed(2)}s`}></i>
                  </span>
                  <span class="bar-value">{bar.display}</span>
                </li>
              ))
            }
          </ul>
          <dl class="tiles">
            {
              spec.results.tiles.map((tile, i) => (
                <div class="in" style={`--d: ${(3.2 + i * 0.9).toFixed(2)}s`}>
                  <dt>{tile.value}</dt>
                  <dd>{tile.text}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- 6. Outro -->
      <section class="scene scene--last" style={timing('outro')}>
        <p class="label in" style="--d: 0.2s">{spec.outro.label}</p>
        <ul class="next">
          {spec.outro.items.map((item, i) => <li class="in" style={`--d: ${(0.5 + i * 0.7).toFixed(2)}s`}>{item}</li>)}
        </ul>
        <p class="repo in" style="--d: 3s">
          <Icon name="github" size={26} />
          {repo}
        </p>
      </section>

      <ol class="progress" aria-hidden="true">
        {sceneIds.map((id) => <li><i style={timing(id)}></i></li>)}
      </ol>
    </div>

    <script is:inline>
      // The clock. Every animation on the page is paused and placed by hand, so the recorder can
      // ask for any instant and get exactly that frame; the same clock runs the live preview.
      (() => {
        const stage = document.querySelector('.stage');
        const total = Number(stage.dataset.total) * 1000;
        const clips = [...document.querySelectorAll('video[data-at]')];

        const seekClip = (clip, ms, exact) => {
          const length = clip.duration || 0;
          if (!length) return Promise.resolve();
          const local = (ms - Number(clip.dataset.at) * 1000) / 1000;
          const target = local <= 0 ? 0 : Math.min(local % length, length - 0.04);
          if (!exact) {
            if (Math.abs(clip.currentTime - target) > 0.08) clip.currentTime = target;
            return Promise.resolve();
          }
          if (Math.abs(clip.currentTime - target) < 0.001) return Promise.resolve();
          return new Promise((resolve) => {
            const done = () => resolve();
            clip.addEventListener('seeked', done, { once: true });
            setTimeout(done, 2000);
            clip.currentTime = target;
          });
        };

        window.__total = total;

        window.__seek = async (ms, exact = false) => {
          for (const animation of document.getAnimations()) animation.currentTime = ms;
          await Promise.all(clips.map((clip) => seekClip(clip, ms, exact)));
          if (exact) await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
        };

        window.__ready = Promise.all([
          document.fonts.ready,
          ...[...document.images].map((img) => img.decode().catch(() => {})),
          ...clips.map(
            (clip) =>
              new Promise((resolve) => {
                if (clip.readyState >= 2) return resolve();
                clip.addEventListener('loadeddata', resolve, { once: true });
                clip.addEventListener('error', resolve, { once: true });
                setTimeout(resolve, 8000);
              }),
          ),
        ]).then(() => window.__seek(0, true));

        // Preview in the browser: fit the frame to the window and loop.
        if (!new URLSearchParams(location.search).has('capture')) {
          const fit = () => {
            const scale = Math.min(innerWidth / stage.offsetWidth, innerHeight / stage.offsetHeight);
            stage.style.transform = `scale(${scale})`;
          };
          fit();
          addEventListener('resize', fit);
          window.__ready.then(() => {
            const start = performance.now();
            const tick = (now) => {
              window.__seek((now - start) % (total + 1200));
              requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  :global(body) {
    overflow: hidden;
    background: #000;
  }

  /* Everything is paused; the clock in the script places each animation. */
  .stage,
  .stage :global(*),
  .stage :global(*)::before,
  .stage :global(*)::after {
    animation-play-state: paused !important;
  }

  .stage {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
    font-size: 20px;
    line-height: 1.4;
    transform-origin: 0 0;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 85% 80% at 60% 30%, #000 20%, transparent 78%);
  }

  /* ---------- Frame furniture ---------- */

  .top {
    position: absolute;
    inset: 30px 72px auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .mark {
    color: var(--accent);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .meta span {
    margin-left: 12px;
    padding-left: 12px;
    border-left: 1px solid var(--line-strong);
  }

  .progress {
    position: absolute;
    inset: auto 72px 30px;
    display: flex;
    gap: 8px;
  }

  .progress li {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .progress i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    animation: grow var(--dur) linear both;
    animation-delay: var(--at);
  }

  /* ---------- Scenes ---------- */

  .scene {
    position: absolute;
    inset: 104px 72px 72px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    animation: scene var(--dur) linear both;
    animation-delay: var(--at);
  }

  .scene--last {
    animation-name: scene-last;
  }

  .in {
    animation: rise 0.7s var(--ease) both;
    animation-delay: calc(var(--at) + var(--d, 0s));
  }

  .pop {
    animation: pop 0.4s var(--ease) both;
    animation-delay: calc(var(--at) + var(--d, 0s));
  }

  .draw {
    stroke-dasharray: 1;
    animation: draw var(--len, 0.55s) var(--ease) both;
    animation-delay: calc(var(--at) + var(--d, 0s));
  }

  .grow {
    transform-origin: 0 50%;
    animation: grow 1s var(--ease) both;
    animation-delay: calc(var(--at) + var(--d, 0s));
  }

  @keyframes scene {
    0% {
      opacity: 0;
    }

    5%,
    95% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes scene-last {
    0% {
      opacity: 0;
    }

    5%,
    100% {
      opacity: 1;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @keyframes sweep {
    from {
      left: 0;
    }

    to {
      left: 100%;
    }
  }

  @keyframes lock-on {
    from {
      opacity: 0;
      transform: scale(1.1);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes zoom {
    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.06);
    }
  }

  /* ---------- Shared type ---------- */

  .label {
    font-family: var(--font-mono);
    font-size: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h1 {
    margin-top: 18px;
    max-width: 12.5em;
    font-size: 62px;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .heading {
    margin-top: 12px;
    font-size: 40px;
    letter-spacing: -0.025em;
  }

  /* Detection brackets, the same mark the portrait carries on the site */
  .corners {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .corners i {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 0 solid var(--accent);
  }

  .tl {
    top: 0;
    left: 0;
    border-top-width: 2px !important;
    border-left-width: 2px !important;
  }

  .tr {
    top: 0;
    right: 0;
    border-top-width: 2px !important;
    border-right-width: 2px !important;
  }

  .bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 2px !important;
    border-left-width: 2px !important;
  }

  .br {
    right: 0;
    bottom: 0;
    border-right-width: 2px !important;
    border-bottom-width: 2px !important;
  }

  .lock {
    animation: lock-on 0.9s var(--ease) both;
    animation-delay: calc(var(--at) + var(--d, 0s));
  }

  .frame {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .frame :global(img),
  .frame video {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius) - 1px);
    object-fit: cover;
  }

  .frame--paper {
    background: #fff;
  }

  .frame--paper :global(img),
  .frame--whole :global(img) {
    object-fit: contain;
  }

  .frame .corners {
    inset: -10px;
  }

  .zoom {
    overflow: hidden;
  }

  .zoom .corners {
    inset: 10px;
  }

  .zoom :global(img) {
    animation: zoom var(--dur) linear both;
    animation-delay: var(--at);
  }

  /* ---------- 1. Title ---------- */

  .title-block {
    position: relative;
    align-self: flex-start;
    width: fit-content;
    margin-left: -8px;
    padding: 34px 44px 40px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 34px 0 0 36px;
  }

  .chips li {
    padding: 9px 13px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 17px;
    line-height: 1;
    color: var(--muted);
  }

  /* ---------- 2. Problem ---------- */

  .scene--split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 500px;
    gap: 64px;
    align-items: center;
  }

  .statement {
    margin-top: 16px;
    font-size: 46px;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .detail {
    margin-top: 24px;
    max-width: 24em;
    font-size: 24px;
    line-height: 1.4;
    color: var(--muted);
  }

  .scene--split .frame {
    height: 360px;
  }

  /* ---------- 3. Approach ---------- */

  .pipe {
    display: flex;
    align-items: stretch;
