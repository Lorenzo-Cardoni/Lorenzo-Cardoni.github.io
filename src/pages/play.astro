---
// The portfolio as a 3D island to fly over. Every entry of the data files becomes a place;
// the text of each one is printed here as HTML and the game (src/game/) only draws the world.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import profile from '../data/profile.json';
import { resolveAssetImage } from '../utils/images';
import { ZONES, buildWorld, clientData } from '../game/stations';

const world = buildWorld();
const stations = await Promise.all(
  world.stations.map(async (s) => ({ ...s, img: s.entry.image ? await resolveAssetImage(s.entry.image) : null })),
);
// The places list follows the way through the island: zone by zone, in the order places are got to know.
const groups = ZONES.map((g) => ({ ...g, items: stations.filter((s) => s.zone === g.id).sort((a, b) => a.order - b.order) })).filter((g) => g.items.length);
// Logos for the boards in front of the places: src/assets/logos/<file>, resized for the canvas.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logos/*.{png,jpg,jpeg,webp,svg}', { eager: true });
const logoUrls = new Map<string, string>();
for (const [path, mod] of Object.entries(logoFiles)) {
  const file = path.split('/').pop()!;
  const keepAlpha = /\.(png|svg|webp)$/i.test(file);
  const built = await getImage({ src: mod.default, width: Math.min(800, mod.default.width), format: keepAlpha ? 'webp' : 'jpg' });
  logoUrls.set(file, built.src);
}
const data = JSON.stringify(clientData(world, (file) => logoUrls.get(file)));
const total = stations.length;
const years = world.gates.map((g) => Number(g.label)).filter(Boolean);
const span = years.length ? `${Math.min(...years)} to today` : 'start to today';
const spanIt = years.length ? `dal ${Math.min(...years)} a oggi` : 'dall’inizio a oggi';
const ZONE_IT: Record<string, string> = {
  start: 'Partenza',
  plateau: 'L’altopiano',
  valley: 'La valle',
  yard: 'Il cortile',
  harbour: 'Il porto',
  islet: 'L’isolotto',
  mountain: 'La montagna',
};

const title = `Isola Vitae | ${profile.name}`;
const description = `Isola Vitae: ${profile.name}'s portfolio as a 3D island. Explore ${total} places as a ghost, one for every job, degree and project.`;
---

<Layout title={title} description={description} path="play/" edgeToEdge>
  <main id="main" class="game">
    <div id="stage" class="stage" aria-hidden="false"></div>

    <!-- Detection box drawn around the place in view, like the portrait on the home page -->
    <div id="detect" class="detect" hidden aria-hidden="true">
      <span id="detect-label" class="detect-label"></span>
      <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
    </div>

    <header class="hud top">
      <a class="chip back" href="/" aria-label="Back to the portfolio" data-it-aria="Torna al portfolio">
        <Icon name="arrow-left" size={16} />
        <span class="when-wide" aria-hidden="true">Portfolio</span>
      </a>
      <p class="chip counter mono" aria-live="polite">
        <span class="when-wide" data-it="Conosciuti">Known</span>
        <strong id="hud-count">0</strong>/<span>{total}</span>
      </p>
      <div class="tools">
        <button class="chip icon play-only" type="button" data-open-forms hidden aria-label="Change shape" data-it-aria="Cambia forma">
          <Icon name="swap" size={16} />
        </button>
        <button class="chip" type="button" data-open-places>
          <Icon name="list" size={16} />
          <span class="when-wide" data-it="Luoghi">Places</span>
        </button>
        <button class="chip lang mono" type="button" data-lang-toggle aria-label="Language: English or Italian" data-it-aria="Lingua: inglese o italiano">
          <span data-lang-label>EN</span>
        </button>
        <button class="chip icon" type="button" data-fullscreen hidden aria-label="Full screen" data-it-aria="Schermo intero">
          <span class="when-window"><Icon name="expand" size={16} /></span>
          <span class="when-full"><Icon name="shrink" size={16} /></span>
        </button>
        <button class="chip icon" type="button" data-theme-toggle aria-label="Switch color theme" data-it-aria="Cambia tema dei colori">
          <span class="when-dark"><Icon name="sun" size={16} /></span>
          <span class="when-light"><Icon name="moon" size={16} /></span>
        </button>
        <button class="chip icon play-only" type="button" data-help aria-label="Controls and help" data-it-aria="Comandi e aiuto">
          <Icon name="help" size={16} />
        </button>
      </div>
    </header>

    <div class="hud bottom-left play-only" aria-hidden="true">
      <canvas id="minimap" class="minimap" width="168" height="168"></canvas>
      <p id="hud-stats" class="stats mono">SPD 0 m/s</p>
    </div>

    <div id="card" class="card" hidden>
      <div class="card-text">
        <p id="card-kicker" class="card-kicker mono"></p>
        <p id="card-title" class="card-title"></p>
        <p id="card-sub" class="card-sub"></p>
      </div>
      <button class="chip card-more" type="button" data-open-entry>
        <span data-it="Altro">More</span> <kbd class="when-keys">Enter</kbd>
      </button>
    </div>

    <button id="ride" class="chip ride" type="button" data-ride hidden>
      <Icon name="swap" size={16} />
      <span id="ride-label" data-it="Possiedi">Possess</span>
      <kbd class="when-keys">E</kbd>
    </button>

    <!-- The secret: shown once the explosives are found -->
    <button id="blast" class="chip blast play-only" type="button" data-blast hidden aria-label="Drop a charge" data-it-aria="Lascia una carica">
      <span aria-hidden="true">💣</span>
      <kbd class="when-keys">X</kbd>
    </button>

    <div class="touch play-only" aria-hidden="true">
      <div id="stick" class="stick"><span id="stick-knob" class="knob"></span></div>
      <div class="lift">
        <button type="button" class="chip icon" data-rise tabindex="-1"><Icon name="up" size={22} /></button>
        <button type="button" class="chip icon" data-sink tabindex="-1"><Icon name="down" size={22} /></button>
      </div>
    </div>

    <p id="objective" class="objective play-only" hidden aria-live="polite"></p>

    <p id="toast" class="toast" role="status" aria-live="polite"></p>

    <section id="intro" class="intro" aria-labelledby="intro-title">
      <div class="intro-card">
        <p class="eyebrow">{profile.name} · Portfolio in 3D</p>
        <h1 id="intro-title">Isola Vitae.</h1>
        <p class="lede" data-it={`Un piccolo fantasma, e un’isola costruita dal mio CV. Ogni edificio è un lavoro, una laurea o un progetto. La strada attorno alla montagna è la linea del tempo, ${spanIt}, con un portale per ogni anno.`}>
          A small ghost, and an island built from my CV. Each building is a job, a degree or a project.
          The road around the mountain is the timeline, {span}, with a gate for every year.
        </p>
        <p class="goal" data-it-html={`<strong>Obiettivo:</strong> conoscere tutti i ${total} luoghi: basta avvicinarsi a uno. La riga in alto e la freccia arancione mostrano sempre cosa fare.`}>
          <strong>Goal:</strong> get to know all {total} places: walk up to one and it is known. The line at the top of the
          screen and the orange arrow always show what to do next.
        </p>
        <dl class="controls">
          <div><dt><kbd>W</kbd><kbd>S</kbd> <span class="or" data-it="o">or</span> <kbd>↑</kbd><kbd>↓</kbd></dt><dd data-it="Avanti, indietro">Forward, back</dd></div>
          <div><dt><kbd>A</kbd><kbd>D</kbd> <span class="or" data-it="o">or</span> <kbd>←</kbd><kbd>→</kbd></dt><dd data-it="Gira">Turn</dd></div>
          <div><dt><kbd>E</kbd></dt><dd data-it="Possiedi la macchina vicina, lasciala">Possess the machine nearby, leave it</dd></div>
          <div><dt><kbd>Q</kbd></dt><dd data-it="Trasformati in una macchina già posseduta">Turn into a machine possessed before</dd></div>
          <div><dt><kbd>Space</kbd><kbd>Shift</kbd></dt><dd data-it="Sali, scendi (drone)">Climb, descend (drone)</dd></div>
          <div><dt><kbd>Enter</kbd> <kbd>Esc</kbd></dt><dd data-it="Apri, chiudi la pagina del luogo inquadrato">Open, close the page of the place in view</dd></div>
          <div><dt><kbd>P</kbd></dt><dd data-it="Elenco dei luoghi, per spostarti">List of places, to travel</dd></div>
          <div><dt data-it="Trascina, rotella">Drag, wheel</dt><dd data-it="Guarda attorno, zoom">Look around, zoom</dd></div>
        </dl>
        <ul class="touch-note">
          <li data-it-html="<strong>Joystick</strong> a sinistra: avanti e indietro, gira."><strong>Stick</strong> on the left: forward and back, turn.</li>
          <li data-it-html="<strong>Possiedi</strong> compare vicino a una macchina; <strong>Lascia</strong> ti fa uscire; il pulsante delle forme in alto ti trasforma in una macchina già posseduta."><strong>Possess</strong> appears next to a machine; <strong>Leave</strong> gets you out; the shapes button at the top turns you into any machine possessed before.</li>
          <li data-it-html="<strong>Frecce</strong> a destra, sul drone: sali e scendi."><strong>Arrows</strong> on the right, on the drone: climb and descend.</li>
          <li data-it-html="<strong>Trascina</strong> altrove per guardarti attorno, <strong>pizzica</strong> per lo zoom."><strong>Drag</strong> anywhere else to look around, <strong>pinch</strong> to zoom.</li>
          <li data-it-html="Avvicinati a un luogo per conoscerlo: una piccola scheda lo mostra, e <strong>Altro</strong> apre la sua pagina. <strong>Luoghi</strong> ti riporta in ogni parte dell’isola già raggiunta.">Walk up to a place to get to know it: a small card shows it, and <strong>More</strong> opens its page. <strong>Places</strong> takes you back to any part of the island you reached.</li>
        </ul>

        <div class="intro-settings">
          <button class="chip lang mono" type="button" data-lang-toggle aria-label="Language: English or Italian" data-it-aria="Lingua: inglese o italiano">
            <span data-lang-label>EN</span>
          </button>
          <button class="chip icon" type="button" data-theme-toggle aria-label="Switch color theme" data-it-aria="Cambia tema dei colori">
            <span class="when-dark"><Icon name="sun" size={16} /></span>
            <span class="when-light"><Icon name="moon" size={16} /></span>
          </button>
        </div>

        <div class="intro-actions">
          <button class="btn" type="button" data-start>
            <span data-it="Inizia">Start</span>
            <Icon name="arrow-right" size={16} />
          </button>
          <button class="btn btn--ghost" type="button" data-open-places>
            <Icon name="list" size={16} />
            <span data-it="Sfoglia i luoghi">Browse the places</span>
          </button>
          <a class="link" href="/" data-it="Leggi il portfolio classico">Read the classic portfolio</a>
        </div>
        <p class="no-gl-note" data-it="Questo browser non può disegnare grafica 3D, quindi l’isola resta nascosta. Tutti i luoghi sono comunque nell’elenco qui sopra.">
          This browser cannot draw 3D graphics, so the island stays hidden. Every place is still in the list above.
        </p>
      </div>
    </section>

    <aside id="sheet" class="sheet" hidden aria-label="Place details">
      <div class="sheet-head">
        <button class="chip icon" type="button" data-close-sheet aria-label="Close" data-it-aria="Chiudi">
          <Icon name="close" size={18} />
        </button>
      </div>
      {
        stations.map((s) => (
          <article class="entry" data-entry={s.id} hidden>
            <p class="kicker mono">
              <span class="tagline">{s.tag}</span>
              {s.entry.kicker}
            </p>
            <h2>{s.entry.title}</h2>
            {s.entry.sub && <p class="sub">{s.entry.sub}</p>}
            {s.img && (
              <figure class="shot">
                <Image src={s.img} alt={s.entry.imageAlt} widths={[400, 640]} sizes="(max-width: 599px) 92vw, 420px" loading="lazy" />
              </figure>
            )}
            {s.entry.text.map((t) => (
              <p class="text">{t}</p>
            ))}
            {s.entry.points.length > 0 && (
              <ul class="points">
                {s.entry.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
            {s.entry.facts.length > 0 && (
              <dl class="facts">
                {s.entry.facts.map((f) => (
                  <div>
                    <dt class="mono">{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {s.entry.lists.map((l) => (
              <div class="group">
                <h3 class="mono">{l.title}</h3>
                <ul class="tags">
                  {l.items.map((i) => (
                    <li class="tag">{i}</li>
                  ))}
                </ul>
              </div>
            ))}
            {s.entry.tags.length > 0 && (
              <ul class="tags" aria-label="Technologies">
                {s.entry.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            )}
            {s.entry.links.length > 0 && (
              <div class="links">
                {s.entry.links.map((l) => (
                  <a
                    class={l.style === 'btn' ? 'btn' : l.style === 'ghost' ? 'btn btn--ghost' : 'link'}
                    href={l.href}
                    target={l.external ? '_blank' : undefined}
                    rel={l.external ? 'noopener' : undefined}
                  >
                    {l.icon && <Icon name={l.icon} size={16} />}
                    {l.label}
                    {l.style === 'link' && <Icon name="arrow-up-right" size={15} />}
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </aside>

    <dialog id="places" class="places" aria-labelledby="places-title">
      <header class="places-head">
        <div>
          <p class="eyebrow" data-it="Luoghi">Places</p>
          <h2 id="places-title" data-it="Dove vuoi andare?">Where to?</h2>
          <p class="places-note" data-it="I luoghi lungo il percorso. Scegline uno in una parte dell’isola già raggiunta e il fantasma ricompare lì; quando il drone vola, il pilota automatico ti porta ovunque. Una spunta segna i luoghi conosciuti, un trattino quelli ancora irraggiungibili.">The places along the way. Pick one in a part of the island you have reached and the ghost reappears there; once the drone flies, the autopilot takes you anywhere. A tick marks the places known, a dash the ones still out of reach.</p>
        </div>
        <form method="dialog">
          <button class="chip icon" type="submit" aria-label="Close the list" data-it-aria="Chiudi l’elenco">
            <Icon name="close" size={18} />
          </button>
        </form>
      </header>
      {
        groups.map((g) => (
          <section class="place-group">
            <h3 class="mono" data-it={ZONE_IT[g.id]}>{g.label}</h3>
            <ul>
              {g.items.map((s) => (
                <li data-place={s.id} data-zone={s.zone}>
                  <button type="button" data-goto={s.id}>
                    <span class="tick" aria-hidden="true" />
                    <span class="place-n mono" aria-hidden="true">{s.order + 1}</span>
                    <span class="place-text">
                      <span class="place-title">{s.title}</span>
                      <span class="place-sub">{s.sub}</span>
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </dialog>

    <dialog id="forms" class="forms" aria-labelledby="forms-title">
      <header class="places-head">
        <div>
          <p class="eyebrow" data-it="Forme">Shapes</p>
          <h2 id="forms-title" data-it="Trasformati in…">Turn into…</h2>
          <p class="places-note when-keys" data-it="Frecce per scegliere, Invio per trasformarti, Q o Esc per chiudere.">Arrows to choose, Enter to turn, Q or Esc to close.</p>
        </div>
        <form method="dialog">
          <button class="chip icon" type="submit" aria-label="Close" data-it-aria="Chiudi">
            <Icon name="close" size={18} />
          </button>
        </form>
      </header>
      <div class="form-grid">
        {
          [
            ['ghost', 'Ghost', 'Walks; no water, no heights', 'Fantasma', 'Cammina; niente acqua né altezze'],
            ['bike', 'E-bike', 'Climbs the ramp', 'E-bike', 'Sale la rampa'],
            ['car', 'Bosch car', 'Fast; jumps the river', 'Auto Bosch', 'Veloce; salta il fiume'],
            ['robot', 'Litter robot', 'Clears litter', 'Robot spazzino', 'Toglie la spazzatura'],
            ['boat', 'Boat', 'Crosses the sea', 'Barca', 'Attraversa il mare'],
            ['drone', 'Drone', 'Flies anywhere', 'Drone', 'Vola ovunque'],
          ].map(([id, name, use, nameIt, useIt]) => (
            <button type="button" class="form" data-form={id} hidden={id !== 'ghost'}>
              <span class="form-icon">
                <Icon name={id} size={30} />
              </span>
              <span class="form-name" data-it={nameIt}>{name}</span>
              <span class="form-use" data-it={useIt}>{use}</span>
            </button>
          ))
        }
      </div>
    </dialog>

    <dialog id="finale" class="finale" aria-labelledby="finale-title">
      <p class="eyebrow" data-it={`${total} luoghi su ${total}`}>{total} of {total} places</p>
      <h2 id="finale-title" data-it="Conosci tutta l’isola.">You know the whole island.</h2>
      <p class="lede" data-it="Grazie della visita. Questo è tutto il mio CV, dal primo anno di università a oggi. Se qualcosa ti ha colpito, ne parlerei volentieri.">
        Thanks for visiting. That is everything on my CV, from the first year of university to today. If something
        caught your eye, I would be glad to talk about it.
      </p>
      <div class="intro-actions">
        <a class="btn" href={`mailto:${profile.email}`}>
          <Icon name="mail" size={16} />
          <span data-it="Contattami">Get in touch</span>
        </a>
        <a class="btn btn--ghost" href={profile.resumeUrl} target="_blank" rel="noopener">
          <Icon name="download" size={16} />
          <span data-it="Scarica il CV">Download CV</span>
        </a>
      </div>
      <div class="finale-foot">
        <button class="link" type="button" data-keep-exploring data-it="Continua a esplorare">Keep exploring</button>
        <button class="link" type="button" data-start-over data-it="Ricomincia">Start over</button>
      </div>
    </dialog>

    <noscript>
      <p class="noscript">Isola Vitae needs JavaScript. <a href="/">Read the classic portfolio</a> instead.</p>
    </noscript>
  </main>

  <script is:inline id="game-data" type="application/json" set:html={data} />
  <script>
    import '../game/game';
  </script>
</Layout>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  [hidden] {
    display: none !important;
  }

  .game {
    position: fixed;
    inset: 0;
    background: var(--bg);
    color: var(--text);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  .stage,
  .stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    outline: none;
  }

  /* ---------- HUD ---------- */

  .hud {
    position: absolute;
    z-index: 5;
    pointer-events: none;
  }

  .hud > *,
  .tools > * {
    pointer-events: auto;
  }

  .top {
    inset: 0 0 auto 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: max(12px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) 0 max(16px, env(safe-area-inset-left));
  }

  .tools {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .chip.icon {
    padding: 0;
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .counter {
    gap: 4px;
    cursor: default;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .counter:hover {
    border-color: var(--line-strong);
    color: var(--muted);
  }

  .counter strong {
    color: var(--accent);
    font-weight: 600;
  }

  :global([data-theme='dark']) .when-light,
  :global([data-theme='light']) .when-dark {
    display: none;
  }

  .when-dark,
  .when-light,
  .when-window,
  .when-full {
    line-height: 0;
  }

  :global(body.is-full) .when-window,
  :global(body:not(.is-full)) .when-full {
    display: none;
  }

  .bottom-left {
    left: max(16px, env(safe-area-inset-left));
    bottom: max(16px, env(safe-area-inset-bottom));
    display: grid;
    gap: 8px;
  }

  .minimap {
    width: 168px;
    height: 168px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .stats {
    color: var(--muted);
    font-size: 0.72rem;
    text-shadow: 0 1px 2px var(--bg);
  }

  /* ---------- Detection box ---------- */

  .detect {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    pointer-events: none;
    will-change: transform, width, height;
  }

  .detect-label {
    position: absolute;
    left: -2px;
    bottom: 100%;
    margin-bottom: 6px;
    padding: 4px 7px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    border-radius: 3px;
    opacity: 0.75;
  }

  .c {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 0 solid var(--accent);
    opacity: 0.75;
  }

  .detect.is-locked .c,
  .detect.is-locked .detect-label {
    opacity: 1;
  }

  .tl {
    top: 0;
    left: 0;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .tr {
    top: 0;
    right: 0;
    border-top-width: 2px;
    border-right-width: 2px;
  }

  .bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 2px;
    border-left-width: 2px;
  }

  .br {
    bottom: 0;
    right: 0;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }

  /* ---------- Card of the place in view ---------- */

  .card {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: max(20px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    max-width: min(440px, calc(100vw - 2 * 260px));
    padding: 8px 8px 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .card-text {
    min-width: 0;
  }

  .card-kicker {
    color: var(--faint);
    font-size: 0.66rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-kicker:global(.is-known) {
    color: var(--accent);
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-sub {
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-more {
    flex: none;
    min-height: 36px;
    font-size: 0.8rem;
  }

  .card-more kbd {
    margin-left: 2px;
  }

  @media (max-width: 1000px) {
    .card {
      max-width: calc(100vw - 2 * 200px);
    }
  }

  kbd {
    display: inline-block;
    min-width: 1.8em;
    padding: 2px 6px;
    border: 1px solid currentColor;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.3;
    text-align: center;
    opacity: 0.8;
  }

  .lang {
    min-width: 44px;
    padding: 0 10px;
    font-size: 0.78rem;
  }

  /* The secret's button: above the machine button. */
  .blast {
    position: absolute;
    z-index: 5;
    right: max(16px, env(safe-area-inset-right));
    bottom: calc(max(20px, env(safe-area-inset-bottom)) + 56px);
    gap: 6px;
    border-color: #e0602c;
    font-size: 1.1rem;
  }

  /* ---------- Vehicle switch ---------- */

  .ride {
    position: absolute;
    z-index: 5;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    border-color: var(--accent);
  }

  .ride kbd {
    margin-left: 2px;
  }

  /* Only the drone climbs */
  :global(body:not([data-vehicle='drone'])) .lift {
    visibility: hidden;
  }

  /* ---------- Toast ---------- */

  /* ---------- Objective ---------- */

  .objective {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: calc(max(12px, env(safe-area-inset-top)) + 58px);
    transform: translateX(-50%);
    max-width: min(560px, calc(100vw - 32px));
    padding: 7px 14px 7px 30px;
    border: 1px solid var(--signal, #ff8a4c);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--text);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    pointer-events: none;
  }

  /* The arrow's color, as a dot in front of the line. */
  .objective::before {
    content: '';
    position: absolute;
    left: 12px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: #ff8a4c;
  }

  .toast {
    position: absolute;
    z-index: 6;
    left: 50%;
    top: calc(max(12px, env(safe-area-inset-top)) + 104px);
    transform: translate(-50%, -8px);
    max-width: calc(100vw - 32px);
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s,
      transform 0.25s var(--ease);
  }

  .toast:empty {
    padding: 0;
  }

  .toast:global(.is-brief) {
    max-width: min(340px, calc(100vw - 32px));
    padding: 5px 10px;
    font-size: 0.7rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    background: color-mix(in srgb, var(--accent) 88%, transparent);
  }

  @media (max-width: 599px) {
    .toast {
      max-width: min(420px, calc(100vw - 32px));
      padding: 8px 12px;
      font-size: 0.72rem;
      line-height: 1.35;
    }

    .toast:global(.is-brief) {
      padding: 4px 9px;
      font-size: 0.66rem;
    }
  }

  .toast:global(.is-on) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* ---------- Touch controls ---------- */

  .touch {
    display: none;
  }

  @media (pointer: coarse) {
    .touch {
      position: absolute;
      z-index: 4;
      inset: auto 0 0 0;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 0 max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
      pointer-events: none;
    }

    .touch > * {
      pointer-events: auto;
    }

    .stick {
      position: relative;
      display: grid;
      place-items: center;
      width: 132px;
      height: 132px;
      border: 1px solid var(--line-strong);
      border-radius: 50%;
      background: color-mix(in srgb, var(--bg) 55%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      touch-action: none;
    }

    .knob {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: var(--accent);
      opacity: 0.85;
    }

    .lift {
      display: grid;
      gap: 10px;
    }

    .lift .chip {
      width: 60px;
      height: 60px;
      touch-action: none;
    }

    /* The map moves up, the stick takes its corner */
    .bottom-left {
      bottom: auto;
      top: calc(max(12px, env(safe-area-inset-top)) + 56px);
    }

    .minimap {
      width: 104px;
      height: 104px;
    }

    .ride {
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 148px);
    }

    .blast {
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 148px + 54px);
    }

    /* Beside the minimap, which takes the top left corner. */
    .objective {
      left: calc(max(16px, env(safe-area-inset-left)) + 112px);
      right: max(16px, env(safe-area-inset-right));
      transform: none;
      max-width: none;
      border-radius: var(--radius-sm);
      font-size: 0.74rem;
      text-align: left;
    }

    .toast {
      top: calc(max(12px, env(safe-area-inset-top)) + 56px + 104px + 8px);
    }

    /* On a touch screen the card sits under the minimap, clear of the stick, the arrows and the
       machine button. */
    .card {
      left: max(16px, env(safe-area-inset-left));
      right: auto;
      bottom: auto;
      top: calc(max(12px, env(safe-area-inset-top)) + 56px + 104px + 64px);
      transform: none;
      max-width: min(300px, calc(100vw - 32px));
    }

    /* While playing, a place's page is a panel at the top, clear of the stick and the arrows,
       so the visitor keeps moving while reading. */
    :global(body.is-playing) .sheet {
      top: calc(max(12px, env(safe-area-inset-top)) + 56px);
      bottom: auto;
      left: max(8px, env(safe-area-inset-left));
      right: max(8px, env(safe-area-inset-right));
      width: auto;
      height: auto;
      max-height: 40dvh;
      border: 1px solid var(--line-strong);
      border-radius: calc(var(--radius) + 4px);
    }

    .when-keys {
      display: none;
    }
  }

  /* Phone held sideways: little height, plenty of width. The controls shrink, the vehicle button
     sits above the arrows, and a place's page is a panel on the right, above them. */
  @media (pointer: coarse) and (max-height: 520px) and (orientation: landscape) {
    .stick {
      width: 112px;
      height: 112px;
    }

    .knob {
      width: 46px;
      height: 46px;
    }

    .lift .chip {
      width: 52px;
      height: 52px;
    }

    .minimap {
      width: 84px;
      height: 84px;
    }

    .ride {
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 124px);
    }

    .blast {
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 124px + 54px);
    }

    .card {
      top: calc(max(12px, env(safe-area-inset-top)) + 56px + 84px + 26px);
      max-width: min(300px, 40vw);
    }

    :global(body.is-playing) .sheet {
      left: auto;
      width: min(380px, 46vw);
      max-height: none;
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 176px);
    }

    .intro {
      place-items: start center;
      padding-top: calc(max(12px, env(safe-area-inset-top)) + 60px);
    }
  }

  /* On a computer: larger text throughout, and a larger minimap. */
  @media (pointer: fine) and (min-width: 900px) {
    :global(html) {
      font-size: 112.5%;
    }

    .minimap {
      width: 236px;
      height: 236px;
    }

    .stats {
      font-size: 0.8rem;
    }
  }

  :global(body:not(.is-playing)) .play-only {
    display: none;
  }

  /* ---------- Intro ---------- */

  .intro {
    position: absolute;
    inset: 0;
    z-index: 8;
    display: grid;
    place-items: center;
    padding: 72px 16px 24px;
    overflow-y: auto;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    touch-action: pan-y;
    user-select: text;
    -webkit-user-select: text;
  }

  .intro-card {
    width: min(640px, 100%);
    padding: clamp(24px, 5vw, 44px);
    border: 1px solid var(--line-strong);
    border-radius: calc(var(--radius) + 4px);
    background:
      radial-gradient(ellipse 70% 90% at 100% 0%, var(--accent-soft), transparent 60%),
      color-mix(in srgb, var(--bg-raised) 92%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: var(--shadow);
    animation: rise 0.6s var(--ease) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .intro h1 {
    margin-top: 14px;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .intro .lede {
    margin-top: 16px;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .goal {
    margin-top: 16px;
    padding: 10px 14px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 1rem;
  }

  .goal strong {
    color: var(--accent);
  }

  /* ---------- The end ---------- */

  .finale {
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
    padding: clamp(24px, 5vw, 40px);
    border: 1px solid var(--line-strong);
    border-radius: calc(var(--radius) + 4px);
    background:
      radial-gradient(ellipse 70% 90% at 100% 0%, var(--accent-soft), transparent 60%),
      var(--bg-raised);
    color: var(--text);
    box-shadow: var(--shadow);
    user-select: text;
    -webkit-user-select: text;
  }

  .finale::backdrop {
    background: rgba(4, 6, 5, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .finale h2 {
    margin-top: 12px;
    font-size: clamp(1.7rem, 5vw, 2.3rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .finale .lede {
    margin-top: 14px;
    color: var(--muted);
  }

  .finale-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .finale-foot .link {
    border: 0;
    background: none;
    padding: 8px 0;
    color: var(--muted);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .finale-foot .link:hover {
    color: var(--accent);
  }

  .intro .lede:first-of-type {
    color: var(--text);
  }

  .controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 20px;
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .controls dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    color: var(--text);
    font-size: 0.86rem;
  }

  .controls dd {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .or {
    color: var(--faint);
    font-size: 0.78rem;
  }

  .touch-note {
    display: none;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }

  .touch-note li + li {
    margin-top: 6px;
  }

  .touch-note strong {
    color: var(--text);
    font-weight: 600;
  }

  @media (pointer: coarse) {
    .controls {
      display: none;
    }

    .touch-note {
      display: block;
    }
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 28px;
  }

  .intro-actions .link {
    margin-left: 4px;
  }

  .no-gl-note {
    display: none;
    margin-top: 18px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  :global(body.no-gl) .no-gl-note {
    display: block;
  }

  :global(body.no-gl) [data-start],
  :global(body.no-gl) .controls,
  :global(body.no-gl) .touch-note {
    display: none;
  }

  /* ---------- Entry sheet ---------- */

  .sheet {
    position: absolute;
    z-index: 9;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(460px, 100vw);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 12px clamp(16px, 4vw, 28px) 24px;
    border-left: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg-raised) 94%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: var(--shadow);
    touch-action: pan-y;
    user-select: text;
    -webkit-user-select: text;
    transform: translateX(24px);
    opacity: 0;
    transition:
      transform 0.3s var(--ease),
      opacity 0.3s;
  }

  .sheet:global(.is-open) {
    transform: none;
    opacity: 1;
  }

  .sheet-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding-top: max(0px, env(safe-area-inset-top));
  }

  .entry {
    margin-top: -20px;
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-right: 56px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
  }

  .tagline {
    padding: 4px 7px;
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: 3px;
    text-transform: none;
    letter-spacing: 0.02em;
    font-weight: 600;
  }

  .entry h2 {
    margin-top: 16px;
    font-size: clamp(1.5rem, 4vw, 1.9rem);
  }

  .sub {
    margin-top: 8px;
    color: var(--muted);
  }

  .shot {
    margin-top: 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }

  .shot img {
    width: 100%;
    height: auto;
  }

  .text {
    margin-top: 14px;
    color: var(--muted);
  }

  .points {
    margin-top: 14px;
    display: grid;
    gap: 6px;
    font-size: 0.95rem;
  }

  .points li {
    position: relative;
    padding-left: 20px;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border: 1px solid var(--accent);
  }

  .facts {
    margin: 18px 0 0;
    display: grid;
    border-top: 1px solid var(--line);
  }

  .facts div {
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
  }

  .facts dd {
    margin: 4px 0 0;
    font-size: 0.94rem;
  }

  .group {
    margin-top: 18px;
  }

  .group h3 {
    margin-bottom: 8px;
    color: var(--faint);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .entry > .tags {
    margin-top: 18px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin-top: 20px;
  }

  .links .btn {
    max-width: 100%;
  }

  /* ---------- Places ---------- */

  .places {
    width: min(620px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--line-strong);
    border-radius: calc(var(--radius) + 4px);
    background: var(--bg-raised);
    color: var(--text);
    box-shadow: var(--shadow);
    overscroll-behavior: contain;
    user-select: text;
    -webkit-user-select: text;
  }

  .places::backdrop {
    background: rgba(4, 6, 5, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .places-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .places-head h2 {
    margin-top: 10px;
    font-size: 1.6rem;
  }

  .places-note {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .place-group {
    margin-top: 22px;
  }

  .place-group h3 {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .place-group button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 52px;
    padding: 8px 6px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .place-group button:hover {
    background: var(--accent-soft);
  }

  .tick {
    flex: none;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--line-strong);
    border-radius: 3px;
  }

  .place-n {
    flex: none;
    width: 1.6em;
    color: var(--faint);
    font-size: 0.74rem;
    text-align: right;
  }

  /* ---------- Shapes ---------- */

  .forms {
    width: min(460px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
    padding: clamp(18px, 3vw, 26px);
    border: 1px solid var(--line-strong);
    border-radius: calc(var(--radius) + 4px);
    background: var(--bg-raised);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  .forms::backdrop {
    background: rgba(4, 6, 5, 0.5);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 18px;
  }

  .form {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 4px;
    min-height: 112px;
    padding: 14px 8px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: none;
    color: var(--text);
    text-align: center;
    cursor: pointer;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .form:hover,
  .form:focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .form-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 4px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .form:global(.is-current) {
    border-color: var(--accent);
    background: var(--accent-soft);
