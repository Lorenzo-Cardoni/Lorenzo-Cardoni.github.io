---
import SectionHeading from './SectionHeading.astro';
import { buildTimeline } from '../utils/timeline';

// Rows come from experience.json and background.json: edit a period there and the chart follows.
const items = buildTimeline();

// The axis runs over whole years, from the first activity to the end of the current year.
const firstYear = Math.floor(Math.min(...items.map((item) => item.start)) / 12);
const endYear = Math.max(Math.ceil(Math.max(...items.map((item) => item.end)) / 12), firstYear + 1);
const years = Array.from({ length: endYear - firstYear }, (_, i) => firstYear + i);
const axisStart = firstYear * 12;
const axisMonths = years.length * 12;

const rows = items.map((item) => {
  const s = (item.start - axisStart) / axisMonths;
  const e = (item.end - axisStart) / axisMonths;
  // The date sits beside its bar, on the side that has room for it.
  const side = e <= 0.66 ? 'after' : s >= 0.3 ? 'before' : 'above';
  return { ...item, s: s.toFixed(4), e: e.toFixed(4), side };
});

const legend = [
  { kind: 'work', label: 'Work' },
  { kind: 'education', label: 'Education' },
  { kind: 'other', label: 'Competitions and research' },
];
---

<section class="section" id="timeline">
  <div class="container">
    <SectionHeading
      label="Timeline"
      title={`Study and work since ${firstYear}.`}
      lede="Degrees, jobs, competitions and research on one axis. Each row opens its details further down the page."
    />

    <div class="chart" style={`--years: ${years.length}`}>
      <ul class="legend mono" aria-hidden="true">
        {
          legend.map((entry) => (
            <li>
              <i class={`swatch swatch--${entry.kind}`} />
              {entry.label}
            </li>
          ))
        }
      </ul>

      <div class="axis mono" aria-hidden="true">
        <span class="axis-pad"></span>
        <ol class="years">
          {years.map((year) => <li>{year}</li>)}
        </ol>
      </div>

      <ol class="rows">
        {
          rows.map((row) => (
            <li>
              <a class={`row row--${row.kind} when--${row.side}`} href={row.href} style={`--s: ${row.s}; --e: ${row.e}`}>
                <span class="label">
                  <span class="title">{row.title}</span>
                  <span class="sub">
                    {row.kindLabel}
                    {row.org && ` · ${row.org}`}
                  </span>
                </span>
                <span class="when mono">{row.period}</span>
                <span class="track">
                  <span class={`bar ${row.ongoing ? 'bar--ongoing' : ''}`} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .chart {
    --label: 330px;
    --gap: clamp(20px, 3vw, 40px);
  }

  /* Legend */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-bottom: 24px;
    color: var(--muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .swatch {
    width: 24px;
    height: 10px;
    border-radius: 3px;
  }

  .swatch--work,
  .row--work .bar {
    background: var(--accent);
  }

  .swatch--education,
  .row--education .bar {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }

  .swatch--other,
  .row--other .bar {
    background: var(--muted);
  }

  /* Year axis and rows share one grid: names on the left, time on the right */
  .axis,
  .row {
    display: grid;
    grid-template-columns: var(--label) minmax(0, 1fr);
    column-gap: var(--gap);
  }

  .years {
    display: grid;
    grid-template-columns: repeat(var(--years), minmax(0, 1fr));
    border-right: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.72rem;
  }

  .years li {
    padding: 0 0 10px 6px;
    border-left: 1px solid var(--line);
    line-height: 1;
  }

  .rows > li {
    border-top: 1px solid var(--line);
  }

  .rows > li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .row {
    --row-bg: var(--bg);
    align-items: center;
    min-height: 62px;
    background: var(--row-bg);
    transition: background-color 0.2s;
  }

  .row:hover {
    --row-bg: var(--bg-raised);
  }

  .row:focus-visible {
    outline-offset: -2px;
  }

  .label {
    display: grid;
    gap: 2px;
    padding: 10px 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color 0.2s;
  }

  .row:hover .title {
    color: var(--accent);
  }

  .sub {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  /* One vertical rule per year, continuous down the chart */
  .track {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    align-self: stretch;
    border-right: 1px solid var(--line);
    background: linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / calc(100% / var(--years)) 100%;
  }

  .bar {
    position: absolute;
    top: 50%;
    left: calc(var(--s) * 100%);
    width: calc((var(--e) - var(--s)) * 100%);
    min-width: 10px;
    height: 12px;
    margin-top: -6px;
    border-radius: 3px;
    transition: transform 0.2s var(--ease);
  }

  .row:hover .bar {
    transform: scaleY(1.34);
  }

  /* An activity still running ends on a live marker instead of a closed edge */
  .bar--ongoing {
    border-radius: 3px 0 0 3px;
  }

  .bar--ongoing::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -5px;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .when {
    position: relative;
    z-index: 1;
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    padding: 3px 6px;
    border-radius: 3px;
    background: var(--row-bg);
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.2;
    white-space: nowrap;
    transition: background-color 0.2s;
  }

  .when--after .when {
    justify-self: start;
    margin-left: calc(var(--e) * 100% + 8px);
  }

  .when--before .when {
    justify-self: end;
    margin-right: calc((1 - var(--s)) * 100% + 8px);
  }

  .when--above .when {
    align-self: start;
    justify-self: start;
    margin: 4px 0 0 calc(var(--s) * 100%);
  }

  /* Narrow screens: name, date, then a full-width track */
  @media (max-width: 899px) {
    .axis,
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .axis {
      position: sticky;
      top: var(--nav-h);
      z-index: 2;
      padding-top: 10px;
      background: var(--bg);
    }

    .axis-pad {
      display: none;
    }

    .years li {
      padding-left: 4px;
    }

    .row {
      row-gap: 6px;
      min-height: 0;
      padding: 14px 0;
    }

    .label {
      padding: 0;
    }

    .row .when {
      grid-column: 1;
      grid-row: auto;
      align-self: auto;
      justify-self: start;
      margin: 0;
      padding: 0;
      background: none;
    }

    .track {
      grid-column: 1;
      grid-row: auto;
      height: 20px;
    }
  }

  @media (max-width: 379px) {
    .years {
      font-size: 0.64rem;
    }

    .years li {
      padding-left: 3px;
    }
  }
</style>
