---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import projects from '../data/projects.json';
import { resolveAssetImage } from '../utils/images';

const featured = await Promise.all(
  projects.featured.map(async (p) => ({ ...p, img: await resolveAssetImage(p.image) })),
);
---

<section class="section" id="projects">
  <div class="container">
    <SectionHeading
      index="03"
      label="Projects"
      title="Selected work."
      lede="Thesis, client and personal projects. Most of them end on real hardware."
    />

    <div class="featured">
      {
        featured.map((p, i) => (
          <article class="project" data-reveal>
            <figure class={`shot ${p.fit === 'contain' ? 'shot--contain' : ''}`}>
              {p.img && (
                <Image
                  src={p.img}
                  alt={p.imageAlt}
                  widths={[480, 720, 1080]}
                  sizes="(max-width: 899px) 92vw, 560px"
                  loading="lazy"
                />
              )}
              <figcaption class="mono">FIG. {String(i + 1).padStart(2, '0')}</figcaption>
            </figure>

            <div class="info">
              <p class="kind mono">
                {p.kind}
                {p.year && <span class="year">{p.year}</span>}
              </p>
              <h3>{p.title}</h3>
              <p class="desc">{p.description}</p>
              <ul class="points">
                {p.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
              <ul class="tags" aria-label="Technologies">
                {p.tech.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
              {p.link && (
                <a class="link" href={p.link} target="_blank" rel="noopener">
                  {p.linkLabel || 'Repository'}
                  <Icon name="arrow-up-right" size={16} />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <h3 class="more-title" data-reveal>More projects</h3>
    <ul class="more">
      {
        projects.more.map((p) => (
          <li class="card" data-reveal>
            <h4>
              {p.link ? (
                <a href={p.link} target="_blank" rel="noopener">
                  {p.title}
                  <Icon name="arrow-up-right" size={15} />
                </a>
              ) : (
                p.title
              )}
            </h4>
            <p>{p.description}</p>
            <ul class="tags" aria-label="Technologies">
              {p.tech.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .featured {
    display: grid;
    gap: clamp(48px, 8vw, 88px);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
  }

  .project:nth-child(even) .shot {
    order: 2;
  }

  .shot {
    position: relative;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  /* Images that must not be cropped sit on white, which matches their own background */
  .shot--contain {
    background: #fff;
  }

  .shot--contain img {
    object-fit: contain;
  }

  .project:hover .shot img {
    transform: scale(1.025);
  }

  figcaption {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 4px 7px;
    border-radius: 3px;
    background: rgba(9, 12, 11, 0.78);
    color: #e9efec;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .kind {
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .year {
    margin-left: 10px;
    padding-left: 10px;
    border-left: 1px solid var(--line-strong);
    color: var(--faint);
  }

  .info h3 {
    margin-top: 12px;
    font-size: clamp(1.35rem, 2.8vw, 1.8rem);
  }

  .desc {
    margin-top: 14px;
    color: var(--muted);
  }

  .points {
    margin-top: 14px;
    display: grid;
    gap: 6px;
    font-size: 0.95rem;
  }

  .points li {
    position: relative;
    padding-left: 20px;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border: 1px solid var(--accent);
  }

  .info .tags {
    margin-top: 18px;
  }

  .info .link {
    margin-top: 18px;
  }

  /* Secondary projects */
  .more-title {
    margin-top: clamp(56px, 9vw, 96px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
    font-size: 1.25rem;
  }

  .more {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    transition: border-color 0.2s;
  }

  .card:hover {
    border-color: var(--line-strong);
  }

  h4 {
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 600;
    line-height: 1.3;
  }

  h4 a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    transition: color 0.2s;
  }

  h4 a :global(svg) {
    flex: none;
    color: var(--faint);
    transform: translateY(2px);
    transition: color 0.2s;
  }

  h4 a:hover,
  h4 a:hover :global(svg) {
    color: var(--accent);
  }

  .card p {
    margin: 10px 0 18px;
    color: var(--muted);
    font-size: 0.93rem;
  }

  .card .tags {
    margin-top: auto;
  }

  @media (max-width: 899px) {
    .project {
      grid-template-columns: 1fr;
    }

    .project:nth-child(even) .shot {
      order: 0;
    }
  }
</style>
