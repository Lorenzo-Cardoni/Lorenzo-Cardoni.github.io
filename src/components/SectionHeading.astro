---
interface Props {
  label: string;
  title: string;
  lede?: string;
}

const { label, title, lede } = Astro.props;
---

<header class="heading">
  <p class="eyebrow">{label}</p>
  <h2>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .heading {
    max-width: 720px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  h2 {
    margin-top: 14px;
    font-size: clamp(1.8rem, 4.2vw, 2.75rem);
  }

  .lede {
    margin-top: 16px;
    color: var(--muted);
    font-size: 1.06rem;
  }
</style>
