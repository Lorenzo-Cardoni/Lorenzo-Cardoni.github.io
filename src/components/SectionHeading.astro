---
interface Props {
  index: string;
  label: string;
  title: string;
  lede?: string;
}

const { index, label, title, lede } = Astro.props;
---

<header class="heading" data-reveal>
  <p class="eyebrow"><span class="idx">{index}</span>{label}</p>
  <h2>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .heading {
    max-width: 720px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .idx {
    color: var(--faint);
    margin-right: 12px;
  }

  h2 {
    margin-top: 14px;
    font-size: clamp(1.8rem, 4.2vw, 2.75rem);
  }

  .lede {
    margin-top: 16px;
    color: var(--muted);
    font-size: 1.06rem;
  }
</style>
