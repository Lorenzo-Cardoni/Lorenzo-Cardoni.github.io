---
import Icon from './Icon.astro';
import profile from '../data/profile.json';

const links = [
  { href: '#about', label: 'About' },
  { href: '#timeline', label: 'Timeline' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#education', label: 'Education' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav" id="site-nav">
  <div class="container bar">
    <a class="brand" href="#top" aria-label={`${profile.name}, back to top`}>
      <svg class="mark" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 9V3h6M15 3h6v6M21 15v6h-6M9 21H3v-6" stroke="currentColor" stroke-width="2.2"></path>
        <rect x="9.5" y="9.5" width="5" height="5" fill="currentColor"></rect>
      </svg>
      <span>{profile.name}</span>
    </a>

    <nav class="links" id="nav-links" aria-label="Sections">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} data-nav-link>
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="menu-only">
          <a href="/play/" data-nav-link>Explore in 3D</a>
        </li>
        <li class="menu-only">
          <a href={profile.resumeUrl} target="_blank" rel="noopener" data-nav-link>
            Download CV
          </a>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <a class="cv play" href="/play/" title="Fly over the portfolio as a 3D island">
        <Icon name="cube" size={15} />
        <span>3D</span>
      </a>
      <a class="cv" href={profile.resumeUrl} target="_blank" rel="noopener">
        <Icon name="download" size={15} />
        <span>CV</span>
      </a>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch color theme">
        <span class="when-dark"><Icon name="sun" /></span>
        <span class="when-light"><Icon name="moon" /></span>
      </button>
      <button
        class="icon-btn menu-btn"
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span class="when-closed"><Icon name="menu" /></span>
        <span class="when-open"><Icon name="close" /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const menuToggle = document.getElementById('menu-toggle');
  const themeToggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  // Theme
  themeToggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    document.getElementById('theme-color')?.setAttribute('content', next === 'dark' ? '#090c0b' : '#f5f7f3');
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be unavailable (private mode); the toggle still works for this visit.
    }
  });

  // Keyboard focus lands at once; smooth scrolling stays for pointer jumps between sections
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') root.style.scrollBehavior = 'auto';
  });
  document.addEventListener('pointerdown', () => root.style.removeProperty('scroll-behavior'));

  // Mobile menu
  const setMenu = (open: boolean) => {
    nav?.classList.toggle('is-open', open);
    menuToggle?.setAttribute('aria-expanded', String(open));
    menuToggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  menuToggle?.addEventListener('click', () => setMenu(!nav?.classList.contains('is-open')));
  document.querySelectorAll('[data-nav-link]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  // Border under the bar once the page has scrolled
  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Highlight the section currently in view
  const navLinks = new Map<string, Element>();
  document.querySelectorAll('[data-nav-link]').forEach((a) => {
    const id = a.getAttribute('href')?.slice(1);
    if (id) navLinks.set(id, a);
  });

  if ('IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          navLinks.forEach((a) => a.removeAttribute('aria-current'));
          navLinks.get(entry.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    navLinks.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) spy.observe(section);
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .nav.is-scrolled,
  .nav.is-open {
    border-bottom-color: var(--line);
  }

  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mark {
    color: var(--accent);
  }

  .links ul {
    display: flex;
    gap: 4px;
  }

  .links a {
    display: block;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .links a:hover,
  .links a[aria-current='true'] {
    color: var(--text);
  }

  .links a[aria-current='true'] {
    background: var(--accent-soft);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cv {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: 0.86rem;
    font-weight: 600;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .cv:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .icon-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .icon-btn span {
    line-height: 0;
  }

  :global([data-theme='dark']) .when-light,
  :global([data-theme='light']) .when-dark,
  .when-open,
  .nav.is-open .when-closed {
    display: none;
  }

  .nav.is-open .when-open {
    display: inline;
  }

  .menu-btn,
  .menu-only {
    display: none;
  }

  @media (max-width: 999px) {
    .menu-btn {
      display: inline-grid;
    }

    .menu-only {
      display: block;
    }

    /* Touch widths: 44px controls */
    .icon-btn {
      width: 44px;
      height: 44px;
    }

    .cv {
      height: 44px;
    }

    .links {
      position: absolute;
      inset: var(--nav-h) 0 auto 0;
      padding: 8px var(--gutter) 20px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      display: none;
    }

    .nav.is-open .links {
      display: block;
    }

    .links ul {
      flex-direction: column;
      gap: 0;
    }

    .links a {
      padding: 14px 4px;
      font-size: 1.02rem;
      border-radius: 0;
      border-bottom: 1px solid var(--line);
    }

    .links li:last-child a {
      border-bottom: 0;
    }

    .links a[aria-current='true'] {
      background: none;
      color: var(--accent);
    }
  }

  .play {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line-strong));
  }

  /* Phones: the CV and 3D links move into the menu so the bar never runs past the screen */
  @media (max-width: 479px) {
    .cv {
      display: none;
    }

    .bar {
      gap: 12px;
    }
  }
</style>
