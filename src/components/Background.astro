---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import profile from '../data/profile.json';
import background from '../data/background.json';
import { anchorId } from '../utils/timeline';

const { publications, education, challenges } = background;
---

<section class="section" id="education">
  <div class="container">
    <SectionHeading label="Research and education" title="Publication, degrees and competitions." />

    {
      publications.map((pub) => (
        <article class="pub" id={anchorId('paper', pub.doi)} data-entry>
          <p class="kicker mono">Publication · {pub.date}</p>
          <h3>{pub.title}</h3>
          <p class="authors">
            {pub.authors.map((author, i) => (
              <>
                {author === profile.name ? <strong>{author}</strong> : author}
                {i < pub.authors.length - 1 ? ', ' : ''}
              </>
            ))}
          </p>
          <p class="venue">{pub.venue}</p>
          <a class="link" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">
            <span class="mono">DOI {pub.doi}</span>
            <Icon name="arrow-up-right" size={16} />
          </a>
        </article>
      ))
    }

    <div class="columns">
      <div>
        <h3 class="col-title">Education</h3>
        <ul class="stack">
          {
            education.map((e) => (
              <li class="item" id={anchorId('degree', e.degree)} data-entry>
                <p class="period mono">{e.period}</p>
                <h4>{e.degree}</h4>
                <p class="school">
                  {e.school}
                  <span class="grade">{e.grade}</span>
                </p>
                <p class="detail">
                  <span class="mono">Thesis</span> {e.thesis}
                </p>
                <p class="detail">
                  <span class="mono">Advisor</span> {e.advisor}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="col-title">Competitions</h3>
        <ul class="stack">
          {
            challenges.map((c) => (
              <li class="item" id={anchorId('competition', c.title)} data-entry>
                <p class="period mono">{c.period}</p>
                <h4>{c.title}</h4>
                <p class="detail">{c.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .pub {
    padding: clamp(22px, 4vw, 36px);
    border: 1px solid var(--line-strong);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .kicker {
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .pub h3 {
    margin-top: 12px;
    max-width: 26em;
    line-height: 1.22;
  }

  .authors {
    margin-top: 14px;
    max-width: 50em;
    color: var(--muted);
    font-size: 0.96rem;
  }

  .authors strong {
    color: var(--text);
    font-weight: 600;
  }

  .venue {
    margin-top: 6px;
    max-width: 50em;
    color: var(--muted);
    font-size: 0.96rem;
    font-style: italic;
  }

  .pub .link {
    margin-top: 8px;
    overflow-wrap: anywhere;
  }

  .columns {
    margin-top: clamp(40px, 6vw, 64px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
  }

  .col-title {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .item {
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .period {
    color: var(--faint);
  }

  h4 {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .school {
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    color: var(--muted);
  }

  .grade {
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .detail {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .detail .mono {
    display: inline-block;
    min-width: 62px;
    color: var(--faint);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 799px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
