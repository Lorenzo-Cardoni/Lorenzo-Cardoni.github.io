---
import '../styles/global.css';
import profile from '../data/profile.json';
import experience from '../data/experience.json';
import background from '../data/background.json';

const { name, jobTitle, location, socials, seo } = profile;

const siteUrl = (Astro.site?.toString() || seo.siteUrl).replace(/\/$/, '') + '/';
const ogImage = new URL(seo.ogImage, siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name,
      url: siteUrl,
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name,
      jobTitle,
      url: siteUrl,
      image: ogImage,
      description: seo.description,
      address: { '@type': 'PostalAddress', addressLocality: 'Ancona', addressCountry: 'IT' },
      worksFor: { '@type': 'Organization', name: experience[0].company },
      alumniOf: { '@type': 'CollegeOrUniversity', name: background.education[0].school },
      knowsAbout: ['Computer vision', 'Large language models', 'Edge AI', 'Machine learning', 'Embedded systems'],
      sameAs: socials.map((s) => s.url),
    },
  ],
};
---

<!doctype html>
<html lang={seo.lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="author" content={name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${name}, ${jobTitle} in ${location}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <meta name="theme-color" content="#090c0b" id="theme-color" />
    <script is:inline>
      // Runs before first paint so the saved theme never flashes.
      (function () {
        var root = document.documentElement;
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch (e) {}
        root.setAttribute('data-theme', theme);
        root.classList.add('js');
        var meta = document.getElementById('theme-color');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#090c0b' : '#f5f7f3');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script>
      // Fade sections in as they enter the viewport.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => observer.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
