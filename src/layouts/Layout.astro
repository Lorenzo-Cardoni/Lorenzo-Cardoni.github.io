---
import '../styles/global.css';
import profile from '../data/profile.json';
import experience from '../data/experience.json';
import background from '../data/background.json';

interface Props {
  /** Page title and description; the home page uses the ones in profile.json. */
  title?: string;
  description?: string;
  /** Path of the page, for the canonical link, e.g. "play/". */
  path?: string;
  /** Lets a full-screen page draw under the notch; it then keeps its controls clear with env(safe-area-inset-*). */
  edgeToEdge?: boolean;
}

const { name, jobTitle, location, socials, seo } = profile;
const { title = seo.title, description = seo.description, path = '', edgeToEdge = false } = Astro.props;

const siteUrl = (Astro.site?.toString() || seo.siteUrl).replace(/\/$/, '') + '/';
const pageUrl = new URL(path, siteUrl).href;
const ogImage = new URL(seo.ogImage, siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name,
      url: siteUrl,
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name,
      jobTitle,
      url: siteUrl,
      image: ogImage,
      description: seo.description,
      address: { '@type': 'PostalAddress', addressLocality: 'Ancona', addressCountry: 'IT' },
      worksFor: { '@type': 'Organization', name: experience[0].company },
      alumniOf: { '@type': 'CollegeOrUniversity', name: background.education[0].school },
      knowsAbout: ['Computer vision', 'Large language models', 'Edge AI', 'Machine learning', 'Embedded systems'],
      sameAs: socials.map((s) => s.url),
    },
  ],
};
---

<!doctype html>
<html lang={seo.lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={`width=device-width, initial-scale=1.0${edgeToEdge ? ', viewport-fit=cover' : ''}`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="author" content={name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${name}, ${jobTitle} in ${location}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <meta name="theme-color" content="#090c0b" id="theme-color" />
    <script is:inline>
      // Runs before first paint so the saved theme never flashes.
      (function () {
        var root = document.documentElement;
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch (e) {}
        root.setAttribute('data-theme', theme);
        root.classList.add('js');
        var meta = document.getElementById('theme-color');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#090c0b' : '#f5f7f3');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
